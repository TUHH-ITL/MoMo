<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanum_maxon_control</name>
  <version>0.1.0</version>
  <description>cmd_vel mecanum drive control for four Maxon EPOS4 controllers over ros2_canopen.</description>
  <maintainer email="itlbot2@example.com">itlbot2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>canopen</build_depend>
  <build_depend>lely_core_libraries</build_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>canopen_core</exec_depend>
  <exec_depend>canopen_master_driver</exec_depend>
  <exec_depend>canopen_402_driver</exec_depend>
  <exec_depend>canopen_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
